{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "greenberry/form",
	"title": "Greenberry Form",
	"category": "widgets",
	"icon": "feedback",
	"description": "Display a saved GDPR-aware Greenberry form.",
	"textdomain": "greenberry",
	"attributes": {
		"formId": {
			"type": "number",
			"default": 0
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": ["wide", "full"],
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	}
}
